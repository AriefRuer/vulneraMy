# VulneraMy Visualization Assistant - server-side environment.
# Copy to .env for local dev. NEVER commit real values. On Vercel, set these
# in Project -> Settings -> Environment Variables (server-safe; the client
# bundle never receives them). NOTE: .env is only for local dev - Vercel does
# NOT read this file; set the same vars in the Vercel dashboard for production.

# --- Current setup: OpenRouter + DeepSeek -----------------------------------
# At least ONE API key is required for the live LLM. The code is OpenAI-
# compatible, so any OpenAI-compatible endpoint works via these three vars.
LLM_API_KEY=            # your OpenRouter key (sk-or-...)
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=deepseek/deepseek-v4-flash-0731   # OpenRouter model id (provider/model)

# Optional OpenRouter attribution headers (shown in the OpenRouter dashboard):
# OPENROUTER_REFERER=https://vulnera-my.vercel.app
# OPENROUTER_TITLE=VulneraMy Employment Analytics

# --- Alternative: OpenAI directly -------------------------------------------
# Leave LLM_BASE_URL/LLM_MODEL unset to default to OpenAI + gpt-4o-mini, and set:
# OPENAI_API_KEY=        # (LLM_API_KEY takes precedence if both are set)

# If NO key is set, /api/assistant still works: it answers deterministically
# from the bundled data (no LLM), so the feature never hard-fails (clause 6.1).
